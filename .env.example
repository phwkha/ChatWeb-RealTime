# File: .env.example
# ============================================================
# SINGLE SOURCE OF TRUTH — Mọi cấu hình nằm ở đây.
# Copy file này thành .env và điền giá trị.
# Khi chuyển môi trường (local ↔ docker), chỉ cần đổi
# các giá trị *_HOST và *_PORT ở mục "CẤU HÌNH KẾT NỐI".
# ============================================================

# =============================================
# CẤU HÌNH KẾT NỐI (thay đổi khi đổi môi trường)
# =============================================
# Local dev : HOST=localhost, MONGO_PORT=27017, POSTGRES_PORT=5433
# Docker    : HOST=cw_mongo/cw_postgres/cw_redis, MONGO_PORT=27017, POSTGRES_PORT=5432

# MongoDB
MONGO_HOST=
MONGO_PORT=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=

# Redis
REDIS_HOST=
REDIS_PORT=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=
SCHEMA_REGISTRY_URL=

# =============================================
# THÔNG TIN XÁC THỰC
# =============================================
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_PASSWORD=

# =============================================
# BẢO MẬT (JWT & SSL)
# =============================================
BACKEND_SSL_PASSWORD=
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=
JWT_SECRET_TEST=

# =============================================
# EMAIL
# =============================================
USERNAME_EMAIL=
PASSWORD_EMAIL=

# =============================================
# CLOUDINARY
# =============================================
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================
# KAFKA CLUSTER
# =============================================
CLUSTER_ID=

# =============================================
# OAUTH2
# =============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# =============================================
# ELK & MONITORING
# =============================================
ELASTIC_PASSWORD=
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# =============================================
# DOCKER HUB
# =============================================
DOCKER_USERNAME=

# =============================================
# URL CẤU HÌNH (Backend & Frontend)
# =============================================
OPENAPI_SERVER_URL=
FRONTEND_URL=
VITE_API_URL=
VITE_API_PROXY_TARGET=
